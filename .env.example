DISCORD_TOKEN=your_discord_bot_token_here

MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/taskdb?retryWrites=true&w=majority

GUILD_ID=your_development_server_id_here

GEMINI_API_KEY=your_gemini_api_key_here
# Optional: extra keys used in order when a key is rate limited (429).
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here

# Optional: overrides the primary summarization model. The built-in fallback
# chain (gemini-3.5-flash-lite -> gemini-3.6-flash -> gemini-3.5-flash) still applies.
GEMINI_MODEL=

# PostgreSQL Configuration (for Docker Compose & database connection)
POSTGRES_USER=tasker
POSTGRES_PASSWORD=taskerpassword
POSTGRES_DB=taskerdb
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tasker:taskerpassword@localhost:5432/taskerdb
